# JWT Secret - Use a secure random string of at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long-and-secure

# App Configuration
PUBLIC_APP_NAME=Community Blog
PUBLIC_APP_DESCRIPTION=Share your thoughts, stories, and insights with the community

# Blog Categories - Comma separated list
# Format: value:Display Name
PUBLIC_BLOG_CATEGORIES=thoughts:Thoughts,reflections:Reflections,lifestyle:Lifestyle,creative:Creative,personal:Personal,tech:Technology,tutorial:Tutorial,politics:Politics
