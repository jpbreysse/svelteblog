JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long-and-secure

# App Configuration
PUBLIC_APP_NAME=ArborSpace.dev
PUBLIC_APP_DESCRIPTION= Democratic knowledge, organically organized

# Blog Categories - Comma separated list
# Format: value:Display Name
PUBLIC_BLOG_CATEGORIES=Documentation:Documentattion,Notes:Notes,Roadmap:Roadmap,Summary:Summary,Others:Others




# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vectordb
DATABASE_POOL_SIZE=10
DATABASE_POOL_IDLE_TIMEOUT=30000

