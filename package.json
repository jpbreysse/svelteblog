{
	"name": "framework",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"start": "node build"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/pg": "^8.15.6",
		"@vitest/browser": "^3.2.3",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.3.1",
		"@xenova/transformers": "^2.17.0",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^12.2.0",
		"cheerio": "^1.0.0",
		"dotenv": "^17.2.3",
		"jsonwebtoken": "^9.0.2",
		"mammoth": "^1.6.0",
		"officeparser": "^6.0.4",
		"pdf-parse": "^1.1.1",
		"pg": "^8.16.3",
		"pgvector": "^0.2.0",
		"quill": "^2.0.3"
	}
}
